# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# Origin your frontend runs on (Vite default shown)
CLIENT_ORIGIN=http://localhost:5173

# Long random string used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Never put a plaintext password here. Generate this by running:
#   node scripts/hash-password.js "your-chosen-password"
# then paste the printed hash below. The plaintext is never stored anywhere.
ADMIN_PASSWORD_HASH=

# From your Razorpay dashboard (Settings -> API Keys). Use the Test Mode
# keys first — they let you rehearse payments with fake cards before you
# switch to Live Mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
