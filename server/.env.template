# ============================================================================
# MANGA STORE SERVER - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to git — it's in .gitignore for security.
#
# For production deployment, set these variables in your hosting platform's
# environment variables/secrets dashboard (Render, Heroku, Railway, etc.)
# ============================================================================

# Server Port (usually set by hosting platform, but can override)
PORT=4000

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Admin password security (plaintext NEVER stored, only the hash)
# 
# HOW TO GENERATE:
#   1. Run: node scripts/hash-password.js "your-secure-password"
#   2. Copy the bcrypt hash output below
#   3. Never share this hash or your plaintext password
#
# TO CHANGE PASSWORD:
#   1. Generate a new hash with the command above
#   2. Update this variable in both .env and your production dashboard
#
ADMIN_PASSWORD_HASH=

# JWT Secret for admin session tokens (signs & validates login tokens)
#
# HOW TO GENERATE:
#   Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# SECURITY NOTE:
#   - This must be long, random, and unique per deployment
#   - If exposed, attackers can forge admin sessions
#   - Change this and re-issue all admin tokens if you suspect compromise
#
JWT_SECRET=

# ============================================================================
# CORS & DEPLOYMENT
# ============================================================================

# The exact URL where your frontend is hosted.
# The server ONLY accepts requests from this origin.
#
# EXAMPLES:
#   Local development:  http://localhost:5173
#   GitHub Pages:       https://username.github.io/repo-name
#   Vercel/Netlify:     https://your-site.vercel.app
#
# If requests fail with CORS errors, double-check this URL exactly matches
# where your frontend is deployed (including protocol, domain, and path).
#
CLIENT_ORIGIN=http://localhost:5173

# ============================================================================
# PAYMENT PROCESSING (Razorpay)
# ============================================================================

# Razorpay API Keys (from dashboard Settings → API Keys)
#
# IMPORTANT:
#   - Start with TEST MODE keys to try payments without real charges
#   - Switch to LIVE MODE keys before accepting real payments
#   - NEVER share these keys; they grant access to payment processing
#   - Keep key_secret secure — only use in backend, never in frontend JS
#
# TEST MODE:
#   These are for development/testing. Use them with test card:
#     4111 1111 1111 1111 (any future expiry, any CVV, any OTP)
#
# LIVE MODE:
#   These process real charges. Only use after thorough testing.
#   Get these from: https://dashboard.razorpay.com/#/app/settings/api-keys
#
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. INITIAL SETUP (Local Development)
#    - Set JWT_SECRET and ADMIN_PASSWORD_HASH (see instructions above)
#    - Set RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET to TEST MODE keys
#    - Leave CLIENT_ORIGIN as localhost for local testing
#    - Run: npm start
#
# 2. PRODUCTION DEPLOYMENT
#    - Add all variables to your hosting platform's secrets/environment
#    - Update CLIENT_ORIGIN to your real frontend URL
#    - Switch RAZORPAY keys from TEST to LIVE mode
#    - Verify everything works before taking real payments
#    - Read the "Production Deployment Checklist" in README.md
#
# 3. SECURITY CHECKLIST
#    - [ ] .env file is in .gitignore and never committed
#    - [ ] All variables are set (no empty values)
#    - [ ] RAZORPAY_KEY_SECRET is only on backend, never in frontend code
#    - [ ] CLIENT_ORIGIN blocks requests from untrusted sources
#    - [ ] JWT_SECRET is long and random
#    - [ ] ADMIN_PASSWORD_HASH is bcrypt hashed, not plaintext
#
# ============================================================================
