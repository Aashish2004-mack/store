cd /d d:\manga-store
echo "# store" >> README.md
git init
git add README.md
git commit -m "first commit"
git branch -M main
git remote add origin https://github.com/Aashish2004-mack/store.git
git push -u origin mainnode_modules
dist
.env
.env.local

# server-side ignores (also covered by server/.gitignore, listed here too
# in case someone runs git from the repo root)
server/node_modules
server/.env
server/data/*.json
!server/data/.gitkeep
